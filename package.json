{
  "name": "catastro-gps-mcp",
  "version": "1.2.2",
  "mcpName": "com.parcelgps/catastro-gps",
  "description": "MCP server for cadastral parcels in 31 European countries and regions: reference, coordinates, Spanish free-text address, geometry, solar, agriculture, market, investment score and comparison",
  "author": "The Hidden Panda <soporte@catastrogps.es>",
  "license": "MIT",
  "type": "module",
  "bin": {
    "catastro-gps-mcp": "./build/index.js"
  },
  "files": [
    "build/**/*.js",
    "build/**/*.d.ts",
    "README.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node build/index.js",
    "start:sse": "node build/sse.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "cadastre",
    "cadastral",
    "catastro",
    "cadastre-api",
    "land-registry",
    "parcel",
    "parcels",
    "gis",
    "geojson",
    "europe",
    "spain",
    "portugal",
    "france",
    "italy",
    "germany",
    "solar",
    "agriculture",
    "real-estate",
    "proptech"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TheHiddenPandaDev/catastro_gps_mcp.git"
  },
  "bugs": {
    "url": "https://github.com/TheHiddenPandaDev/catastro_gps_mcp/issues"
  },
  "homepage": "https://www.catastrogps.es/developers"
}
